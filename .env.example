# ============================================
# PLM ENTERPRISE - Environment Variables
# ============================================
# Copy this to .env and fill in your actual values
# NEVER commit .env to version control

# --- FREE LLM API Keys (Required - at least one) ---
GROQ_API_KEY=gsk_your_groq_key_here
SAMBANOVA_API_KEY=your_sambanova_key_here
GEMINI_API_KEY=your_gemini_key_here

# --- Supabase (Required) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_JWT_SECRET=your_jwt_secret

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# --- Continuous Learning ---
CONTINUOUS_MODE=true
AUTO_TRAIN_THRESHOLD=100
GENERATION_INTERVAL=30

# --- Redis (for background workers) ---
REDIS_URL=redis://localhost:6379/0

# --- Billing (Optional - Stripe) ---
STRIPE_SECRET_KEY=sk_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_STARTER=price_starter_id
STRIPE_PRICE_PROFESSIONAL=price_professional_id
STRIPE_PRICE_ENTERPRISE=price_enterprise_id

# --- Monitoring (Optional) ---
SENTRY_DSN=https://your-sentry-dsn

# --- Deployment (CI/CD) ---
RENDER_API_KEY=your_render_api_key
VERCEL_TOKEN=your_vercel_token

# --- Fine-Tuning GPU Backends (at least one needed for real model training) ---
# Local: No env vars needed — just needs CUDA GPU + pip install peft trl datasets accelerate bitsandbytes
# Runpod: Serverless GPU for production training
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_ID=your_runpod_endpoint_id
# HuggingFace: Managed fine-tuning via AutoTrain
HF_TOKEN=hf_your_huggingface_token

# --- Model Storage ---
PLM_MODELS_DIR=./enterprise/models
PLM_MAX_CACHED_MODELS=2
